# For Docker runtime: copy to .env.docker, then use docker run --env-file .env.docker.
# Dockerfile already sets DJANGO_ENV=docker, so don't override it here.

# Django environment
DJANGO_ENV=docker
DJANGO_DEBUG=false

# Security
DJANGO_SECRET_KEY= 'your-secret-key-here'

# Hosts
DJANGO_ALLOWED_HOSTS=url-without-protocol       #my-url.com
DJANGO_CSRF_TRUSTED_ORIGINS=url-with-protocol   #https://my-url.com

# Database
DJANGO_DB_PATH=/app/FitnessDashboard/db.sqlite3

# Localization
DJANGO_TIME_ZONE=Europe/Berlin

# HTTPS
DJANGO_SECURE_SSL_REDIRECT=true
DJANGO_SESSION_COOKIE_SECURE=true
DJANGO_CSRF_COOKIE_SECURE=true
DJANGO_SECURE_HSTS_SECONDS=3600
